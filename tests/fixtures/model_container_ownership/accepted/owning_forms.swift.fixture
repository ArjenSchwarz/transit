struct Service {
    init(modelContext: ModelContext) {}
}

func makeFixture() throws -> TestModelContainer {
    try TestModelContainer()
}

func makeServiceAndOwner() throws -> (Service, TestModelContainer) {
    let fixture = try TestModelContainer()
    return (Service(modelContext: fixture.context), fixture)
}

struct Environment {
    let fixture: TestModelContainer
    let context: ModelContext
    let service: Service
}

func makeEnvironment() throws -> Environment {
    let fixture = try TestModelContainer()
    return Environment(
        fixture: fixture,
        context: fixture.context,
        service: Service(modelContext: fixture.context)
    )
}
